TEAMVAULT_APP_ROOT=/app
TEAMVAULT_DATABASE_PATH=/app/data/teamvault.db
TEAMVAULT_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
TEAMVAULT_SESSION_DAYS=14
TEAMVAULT_ADMIN_USERNAME=admin
TEAMVAULT_ADMIN_DISPLAY_NAME=TeamVault Admin
TEAMVAULT_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-10-chars
