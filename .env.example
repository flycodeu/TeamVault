# ============================================================
# TeamVault 环境变量配置
# 复制为 .env 后按需修改。注意：TEAMVAULT_APP_ROOT / TEAMVAULT_DATABASE_PATH
# 为 Docker 专用绝对路径；本地开发请改为相对路径或留空（默认 ./data/teamvault.db）。
# ============================================================

# 应用根目录（Docker 内为 /app；本地开发可留空，默认取进程工作目录）
TEAMVAULT_APP_ROOT=/app

# 服务端口
PORT=3030

# SQLite 数据库文件路径（绝对路径或相对 TEAMVAULT_APP_ROOT 的相对路径）
TEAMVAULT_DATABASE_PATH=/app/data/teamvault.db

# 主密钥：必须为「32 字节内容」的 base64 编码（解出后恰好 32 字节，用于 AES-256-GCM 加密凭据）。
# 下面示例解码后为 32 字节，仅作占位 —— 生产环境务必更换为自己的随机密钥，且切勿泄露。
# 生成方式：openssl rand -base64 32
TEAMVAULT_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# 会话有效期（天），默认 14
TEAMVAULT_SESSION_DAYS=14

# 会话 Cookie 是否带 Secure 标记。
# 生产环境（HTTPS）默认 true；若在纯 HTTP 内网部署，请设为 false，否则浏览器会拒绝保存会话 Cookie。
# 可选值：true / 1 / false / 0（留空则按 NODE_ENV=production 判定）
# TEAMVAULT_SECURE_COOKIE=false

# LibreOffice 可执行文件路径（可选，用于 Office 文档转 PDF 预览；默认 soffice）
# LIBREOFFICE_PATH=/usr/bin/soffice

# 初始管理员（首次部署执行 db:bootstrap 或 Docker 自动引导时使用）
TEAMVAULT_ADMIN_USERNAME=admin
TEAMVAULT_ADMIN_DISPLAY_NAME=TeamVault Admin
TEAMVAULT_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-10-chars

# 设为 1 时，db:bootstrap 允许重置已有管理员的密码（仅用于有意的密码重置）
# TEAMVAULT_ADMIN_RESET_PASSWORD=1
